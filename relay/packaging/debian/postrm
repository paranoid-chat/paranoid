#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then
	systemctl daemon-reload || true
fi
if [ "$1" = purge ]; then
	rm -rf /etc/paranoid-relay /var/lib/paranoid-relay
	rm -f /etc/issue.d/paranoid-relay.issue
	if [ -f /etc/ssh/sshd_config.d/00-paranoid-relay.conf ]; then
		rm -f /etc/ssh/sshd_config.d/00-paranoid-relay.conf /etc/ssh/sshd_config.d/00-paranoid-relay.conf.prev
		systemctl reload-or-restart ssh.service >/dev/null 2>&1 || true
	fi
	if getent passwd paranoid-relay >/dev/null; then
		deluser --system --quiet paranoid-relay || true
	fi
fi
exit 0
