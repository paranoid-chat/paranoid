[Unit]
Description=Signal du relais Paranoid vers l'annuaire getparanoid.fr
Documentation=https://getparanoid.fr
After=network-online.target paranoid-relay.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/paranoid-relay announce
User=paranoid-relay
Group=paranoid-relay
UMask=0077
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
